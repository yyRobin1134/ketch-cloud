-/// A cookie-login cloud drive the in-app browser can hand downloads over for. Cookies are only
-/// ever sent to hosts ending in one of [hostSuffixes], and only when every [sessionCookies] name
-/// is present and unexpired.
-private struct SiteProfile: Identifiable, Hashable {
-  let id: String
-  let name: String
-  let startURL: String
-  let referer: String
-  let hostSuffixes: [String]
-  let sessionCookies: [String]
-}
-
-private let siteProfiles: [SiteProfile] = [
-  SiteProfile(id: "uc", name: "UC", startURL: "https://drive.uc.cn/", referer: "https://drive.uc.cn/",
-              hostSuffixes: ["uc.cn"], sessionCookies: ["__pus", "__puus"]),
-  SiteProfile(id: "quark", name: "Quark", startURL: "https://pan.quark.cn/",
-              referer: "https://pan.quark.cn/", hostSuffixes: ["quark.cn"],
-              sessionCookies: ["__pus", "__puus"]),
-  SiteProfile(id: "baidu", name: "Baidu", startURL: "https://pan.baidu.com/",
-              referer: "https://pan.baidu.com/", hostSuffixes: ["baidu.com", "baidupcs.com"],
-              sessionCookies: ["BDUSS"]),
-  SiteProfile(id: "115", name: "115", startURL: "https://115.com/", referer: "https://115.com/",
-              hostSuffixes: ["115.com"], sessionCookies: ["UID", "SEID"]),
-]
-
-private func hostMatches(_ host: String?, _ profile: SiteProfile) -> Bool {
-  guard let host = host?.lowercased() else { return false }
-  return profile.hostSuffixes.contains { host == $0 || host.hasSuffix("." + $0) }
-}
