--- a/app/ios/DashMerger.swift
+++ b/app/ios/DashMerger.swift
@@ -0,0 +1,103 @@
+import AVFoundation
+import SwiftUI
+import UIKit
+
+struct MergedFile: Identifiable {
+  let id = UUID()
+  let url: URL
+}
+
+enum DashMergeError: LocalizedError {
+  case badURL
+  case http(Int)
+  case noTracks
+  case exportFailed(String)
+
+  var errorDescription: String? {
+    switch self {
+    case .badURL: return "Invalid stream address."
+    case .http(let code): return "The stream server answered HTTP \(code)."
+    case .noTracks: return "The streams have no usable video or audio track."
+    case .exportFailed(let message): return "Merging failed: \(message)"
+    }
+  }
+}
+
+/// Bilibili's higher qualities keep picture and sound in two streams. This downloads both, joins
+/// them into one MP4 without re-encoding, and returns the file for the share sheet.
+enum DashMerger {
+  static func merge(
+    videoURL: String, videoHeaders: [String: String],
+    audioURL: String, audioHeaders: [String: String],
+    name: String,
+    progress: @escaping @MainActor (String) -> Void
+  ) async throws -> URL {
+    let work = FileManager.default.temporaryDirectory.appendingPathComponent("dash-\(UUID().uuidString)")
+    try FileManager.default.createDirectory(at: work, withIntermediateDirectories: true)
+    defer { try? FileManager.default.removeItem(at: work.appendingPathComponent("parts")) }
+    let parts = work.appendingPathComponent("parts")
+    try FileManager.default.createDirectory(at: parts, withIntermediateDirectories: true)
+
+    await progress("Downloading video stream…")
+    let video = try await fetch(videoURL, headers: videoHeaders, to: parts.appendingPathComponent("video.mp4"))
+    await progress("Downloading audio stream…")
+    let audio = try await fetch(audioURL, headers: audioHeaders, to: parts.appendingPathComponent("audio.m4a"))
+
+    await progress("Merging…")
+    let videoAsset = AVURLAsset(url: video)
+    let audioAsset = AVURLAsset(url: audio)
+    guard let videoTrack = try await videoAsset.loadTracks(withMediaType: .video).first,
+          let audioTrack = try await audioAsset.loadTracks(withMediaType: .audio).first else {
+      throw DashMergeError.noTracks
+    }
+    let duration = try await videoAsset.load(.duration)
+    let composition = AVMutableComposition()
+    guard let outVideo = composition.addMutableTrack(withMediaType: .video, preferredTrackID: kCMPersistentTrackID_Invalid),
+          let outAudio = composition.addMutableTrack(withMediaType: .audio, preferredTrackID: kCMPersistentTrackID_Invalid) else {
+      throw DashMergeError.noTracks
+    }
+    try outVideo.insertTimeRange(CMTimeRange(start: .zero, duration: duration), of: videoTrack, at: .zero)
+    let audioDuration = try await audioAsset.load(.duration)
+    try outAudio.insertTimeRange(
+      CMTimeRange(start: .zero, duration: min(duration, audioDuration)), of: audioTrack, at: .zero)
+    outVideo.preferredTransform = try await videoTrack.load(.preferredTransform)
+
+    let safe = name.map { "/\\:?*\"<>|".contains($0) ? "_" : String($0) }.joined()
+    let base = safe.hasSuffix(".mp4") ? String(safe.dropLast(4)) : safe
+    let output = work.appendingPathComponent("\(base.isEmpty ? "video" : base).mp4")
+    guard let export = AVAssetExportSession(asset: composition, presetName: AVAssetExportPresetPassthrough) else {
+      throw DashMergeError.exportFailed("no exporter")
+    }
+    export.outputURL = output
+    export.outputFileType = .mp4
+    await export.export()
+    if export.status != .completed {
+      throw DashMergeError.exportFailed(export.error?.localizedDescription ?? "unknown error")
+    }
+    return output
+  }
+
+  private static func fetch(_ address: String, headers: [String: String], to file: URL) async throws -> URL {
+    guard let url = URL(string: address) else { throw DashMergeError.badURL }
+    var request = URLRequest(url: url)
+    for (key, value) in headers where !key.isEmpty { request.setValue(value, forHTTPHeaderField: key) }
+    let (temp, response) = try await URLSession.shared.download(for: request)
+    if let http = response as? HTTPURLResponse, !(200...299).contains(http.statusCode) {
+      throw DashMergeError.http(http.statusCode)
+    }
+    try? FileManager.default.removeItem(at: file)
+    try FileManager.default.moveItem(at: temp, to: file)
+    return file
+  }
+}
+
+/// The system share sheet, so the merged file can be saved to Files or Photos.
+struct ShareSheet: UIViewControllerRepresentable {
+  let url: URL
+
+  func makeUIViewController(context: Context) -> UIActivityViewController {
+    UIActivityViewController(activityItems: [url], applicationActivities: nil)
+  }
+
+  func updateUIViewController(_ controller: UIActivityViewController, context: Context) {}
+}
