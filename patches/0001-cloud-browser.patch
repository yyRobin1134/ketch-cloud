+    url: String,
+    referer: String,
+    cookieHeader: String,
+    userAgent: String,
+  ) {
+    val trimmed = url.trim()
+    val match = Regex("^https://([^/?#:]+)(?::[0-9]+)?(?:[/?#]|$)", RegexOption.IGNORE_CASE)
+      .find(trimmed) ?: return
