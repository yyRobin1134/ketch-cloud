+      header(referer)?.takeIf { it.startsWith("https://") }?.let { put("Referer", it) }
+      header(cookieHeader)?.let { put("Cookie", it) }
+      header(userAgent)?.let { put("User-Agent", it) }
+    }
+    offer(IncomingDownload.Links(listOf(trimmed), LinkSource.Share, headers))
+  }
 
