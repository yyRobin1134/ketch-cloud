+import UIKit
+import WebKit
+import KetchApp
+
+/// Loads a page in a hidden web view for the video sites whose data only exists once the page
+/// has run, polls until the page says it is ready, and hands back the extracted value as JSON text.
+/// The page is loaded as it is: no script touches the navigator or client hints.
+final class WebPageLoaderImpl: NSObject, WebPageLoader {
+  private var jobs: [HiddenPageJob] = []
+
+  func load(request: WebLoadRequest, callback: WebLoadCallback) {
+    DispatchQueue.main.async {
+      let job = HiddenPageJob(request: request, callback: callback)
+      job.onFinish = { [weak self, weak job] in
+        self?.jobs.removeAll { $0 === job }
+      }
+      self.jobs.append(job)
+      job.start()
+    }
+  }
+}
+
+private final class HiddenPageJob: NSObject {
+  var onFinish: (() -> Void)?
+  private let request: WebLoadRequest
+  private let callback: WebLoadCallback
+  private let webView: WKWebView
+  private var finished = false
+  private var polling = false
+  private var deadline = Date()
+
+  init(request: WebLoadRequest, callback: WebLoadCallback) {
+    self.request = request
+    self.callback = callback
+    let config = WKWebViewConfiguration()
+    config.websiteDataStore = WKWebsiteDataStore.default()
+    for script in request.documentStartJs {
+      config.userContentController.addUserScript(
+        WKUserScript(source: script, injectionTime: .atDocumentStart, forMainFrameOnly: true)
+      )
+    }
+    webView = WKWebView(frame: CGRect(x: 0, y: 0, width: 1, height: 1), configuration: config)
+    webView.customUserAgent = request.userAgent
+    super.init()
+  }
+
+  func start() {
+    // A page that is not in a window is throttled, so it is attached as a nearly invisible 1x1 view.
+    webView.alpha = 0.01
+    webView.isUserInteractionEnabled = false
+    let window = UIApplication.shared.connectedScenes
+      .compactMap { ($0 as? UIWindowScene)?.windows.first { $0.isKeyWindow } }
+      .first
+    window?.addSubview(webView)
+    deadline = Date().addingTimeInterval(Double(request.timeoutMs) / 1000.0)
+    if let url = URL(string: request.url) {
+      webView.load(URLRequest(url: url))
+    }
+    schedulePoll()
+  }
+
+  private func schedulePoll() {
+    let interval = max(Double(request.pollIntervalMs) / 1000.0, 0.1)
+    DispatchQueue.main.asyncAfter(deadline: .now() + interval) { [weak self] in
+      self?.poll()
+    }
+  }
+
+  private func poll() {
+    guard !finished else { return }
+    if Date() > deadline {
+      finish(nil)
+      return
+    }
+    guard !polling else {
+      schedulePoll()
+      return
+    }
+    polling = true
+    evaluate(request.readyCheckJs) { [weak self] ready in
+      guard let self, !self.finished else { return }
+      if ready == "true" {
+        self.evaluate(self.request.extractJs) { result in
+          self.finish(result)
+        }
+      } else {
+        self.polling = false
+        self.schedulePoll()
+      }
+    }
+  }
+
+  /// Runs a script the way an Android `evaluateJavascript` does (the value of its last expression)
+  /// and returns that value as JSON text, or nil when it is undefined or the call stalls.
+  private func evaluate(_ script: String, done: @escaping (String?) -> Void) {
+    guard let data = try? JSONSerialization.data(withJSONObject: [script]),
+          let array = String(data: data, encoding: .utf8) else {
+      done(nil)
+      return
+    }
+    let wrapped = "JSON.stringify((0, eval)(\(array)[0]))"
+    var answered = false
+    DispatchQueue.main.asyncAfter(deadline: .now() + 3) {
+      if !answered {
+        answered = true
+        done(nil)
+      }
+    }
+    webView.evaluateJavaScript(wrapped) { value, _ in
+      DispatchQueue.main.async {
+        if answered { return }
+        answered = true
+        done(value as? String)
+      }
+    }
+  }
+
+  private func finish(_ result: String?) {
+    guard !finished else { return }
+    finished = true
+    webView.stopLoading()
+    webView.removeFromSuperview()
+    callback.done(result: result)
+    onFinish?()
+  }
+}
