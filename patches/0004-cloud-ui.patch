+  /**
+   * Receive a download resolved from a cloud-drive share: the direct URL, the file name, and the
+   * headers that file's host demands (cookie, referer, user agent). It stays on this device, like
+   * any download that carries credentials.
+   */
+  fun offerCloudDownload(url: String, fileName: String?, headers: Map<String, String>) {
+    val trimmed = url.trim()
+    if (!trimmed.startsWith("https://", ignoreCase = true) && !trimmed.startsWith("http://", ignoreCase = true)) return
+    // Header text must not carry control characters, which would let a value inject more headers.
+    val safe = headers.filter { (k, v) -> k.none { c -> c.code < 32 } && v.none { c -> c.code < 32 } }
+    offer(IncomingDownload.Links(listOf(trimmed), LinkSource.Share, safe, fileName?.takeIf { it.isNotBlank() }))
+  }
+
